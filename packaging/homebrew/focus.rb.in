class Focus < Formula
  include Language::Python::Virtualenv

  desc "Local-first macOS project workspace manager"
  homepage "@HOMEPAGE@"
  url "@URL@"
  sha256 "@SHA256@"
  version "@VERSION@"
  license "MIT"

  depends_on :macos
  depends_on "python@3.13"

  def install
    virtualenv_install_with_resources
    zsh_completion.install "completions/_focus", "completions/_work"
  end

  test do
    assert_match "focus #{version}", shell_output("#{bin}/focus --version")
    assert_match "focus #{version}", shell_output("#{bin}/work --version")
    assert_path_exists zsh_completion/"_focus"
    assert_path_exists zsh_completion/"_work"
  end
end
